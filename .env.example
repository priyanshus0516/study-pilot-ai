# StudyPilot AI - Environment Configuration

# Flask Secret Key
SECRET_KEY=change-this-to-a-secure-random-string

# Database URL (Default SQLite)
DATABASE_URL=sqlite:///studypilot.db

# Optional AI API Keys (Leave blank to use smart offline study engine)
# Get a Google Gemini API Key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Or OpenAI API Key from: https://platform.openai.com/
OPENAI_API_KEY=

# Preferred AI Provider: 'auto', 'gemini', 'openai', or 'offline'
DEFAULT_AI_PROVIDER=auto
